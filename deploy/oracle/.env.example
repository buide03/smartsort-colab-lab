# Copy this file to .env ON THE VM. Never commit .env or passwords.
SMARTSORT_DOMAIN=your-lab.example.org
SMARTSORT_CLASSROOM_PASSWORD=CHANGE_THIS_BEFORE_DEPLOY
SMARTSORT_DATA_DIR=/opt/smartsort/data
SMARTSORT_UPLOAD_LIMIT_MB=64
SMARTSORT_MAX_IMAGES=1000
SMARTSORT_MAX_SESSIONS=200
SMARTSORT_MAX_IMAGE_STORAGE_MB=512

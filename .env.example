# Local Docker Compose settings. Copy to .env; .env is ignored by Git.
# Railway: enter these values in Variables instead of uploading this file.
SMARTSORT_HTTP_PORT=8000
SMARTSORT_CLASSROOM_PASSWORD=
SMARTSORT_CPU_THREADS=2
SMARTSORT_UPLOAD_LIMIT_MB=64
SMARTSORT_MAX_IMAGES=1000
SMARTSORT_MAX_SESSIONS=200
SMARTSORT_MAX_IMAGE_STORAGE_MB=512
